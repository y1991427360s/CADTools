    (defun lan-get-option (vert_count move_right / kw)
      (initget "Shang Xia")
      (setq kw
        (getkword
          (strcat "\n检测到 " (itoa vert_count)
                  " 条竖直线，副本将右移 " (rtos move_right 2 0)
                  " 单位。请选择方向 [向上(Shang)/向下(Xia)] <向上>: ")))

      (cond
        ((or (null kw) (equal kw "Shang")) "S")
